#!/usr/bin/env bash
# docker-php-pecl-install — install PECL extensions (docker-library/php compatible)
#
# Usage: docker-php-pecl-install redis xdebug apcu
#
# Requires: pecl, phpize, build tools (extension-builder / SDK image only)

set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: docker-php-pecl-install <pecl-package> [<pecl-package> ...]" >&2
    exit 1
fi

docker-php-source extract

for pkg in "$@"; do
    echo ">>> pecl install ${pkg}"
    printf '\n' | pecl install "${pkg}"
    # Derive extension name from package (strip version suffix if present)
    ext_name="${pkg%%-*}"
    docker-php-ext-enable "${ext_name}" 2>/dev/null || docker-php-ext-enable "${pkg}" 2>/dev/null || true
done

rm -rf /tmp/pear 2>/dev/null || true
